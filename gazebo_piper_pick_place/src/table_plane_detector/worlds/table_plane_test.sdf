<?xml version="1.0"?>
<sdf version="1.9">
  <world name="table_plane_test">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.72 0.76 0.82 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 4 0.3 0.2 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -1</direction>
    </light>

    <!-- Top surface is exactly world z=0. -->
    <model name="test_table">
      <static>true</static>
      <link name="table">
        <collision name="collision">
          <pose>0 0 -0.025 0 0 0</pose>
          <geometry><box><size>1.40 1.40 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.025 0 0 0</pose>
          <geometry><box><size>1.40 1.40 0.05</size></box></geometry>
          <material>
            <ambient>0.65 0.65 0.62 1</ambient>
            <diffuse>0.82 0.82 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="cube_obstacle">
      <static>true</static>
      <pose>-0.28 0.02 0.075 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 0.15 0.15</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 0.15 0.15</size></box></geometry>
          <material><ambient>0.85 0.15 0.12 1</ambient><diffuse>0.85 0.15 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cylinder_obstacle">
      <static>true</static>
      <pose>0.28 0.16 0.11 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.08</radius><length>0.22</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.22</length></cylinder></geometry>
          <material><ambient>0.10 0.32 0.88 1</ambient><diffuse>0.10 0.32 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A vertical distractor behind the table tests the normal constraint. -->
    <model name="vertical_distractor">
      <static>true</static>
      <pose>0 0.67 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.30 0.04 0.70</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.30 0.04 0.70</size></box></geometry>
          <material><ambient>0.30 0.35 0.40 1</ambient><diffuse>0.38 0.43 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Gazebo camera convention is +X forward. This pose points it at the table centre. -->
    <model name="table_camera">
      <static>true</static>
      <pose>0 -0.60 1.0 0 1.047197551 1.570796327</pose>
      <link name="camera_link">
        <visual name="body">
          <pose>-0.04 0 0 0 0 0</pose>
          <geometry><box><size>0.08 0.12 0.05</size></box></geometry>
          <material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material>
        </visual>
        <sensor name="rgbd" type="rgbd_camera">
          <topic>table_camera</topic>
          <update_rate>15</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.5844149256643074</horizontal_fov>
            <image>
              <width>848</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.20</near><far>3.0</far></clip>
            <depth_camera><clip><near>0.20</near><far>3.0</far></clip></depth_camera>
            <lens>
              <intrinsics>
                <fx>418.2646789550781</fx>
                <fy>418.2646789550781</fy>
                <cx>424.1576232910156</cx>
                <cy>238.23983764648438</cy>
                <s>0.0</s>
              </intrinsics>
            </lens>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
