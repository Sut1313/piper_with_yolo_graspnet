<?xml version="1.0"?>
<package format="3">
  <name>table_plane_detector</name>
  <version>0.1.0</version>
  <description>Robust RGB-D table plane estimation for simulation and RealSense cameras.</description>
  <maintainer email="323442660+Sut1313@users.noreply.github.com">Sut1313</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>diagnostic_msgs</depend>
  <depend>eigen</depend>
  <depend>libpcl-all-dev</depend>
  <depend>pcl_conversions</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_ros</depend>
