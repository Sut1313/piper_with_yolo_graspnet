<?xml version="1.0"?>
<robot name="piper_lightweight" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    The arm macro, dynamics and meshes are an exact snapshot of the full AG
    robot source. Only package:// mesh URIs were mechanically retargeted to
    this self-contained package; physical values are unchanged.
  -->
  <xacro:include filename="$(find piper_lightweight_sim)/urdf/piper_arm.xacro"/>

  <!-- D435i parameters copied verbatim from AG_robot.urdf.xacro. -->
  <xacro:arg name="camera_pitch_offset" default="0.0"/>
  <xacro:arg name="camera_depth_width" default="848"/>
  <xacro:arg name="camera_depth_height" default="480"/>
  <xacro:arg name="camera_depth_fx" default="418.2646789550781"/>
  <xacro:arg name="camera_depth_fy" default="418.2646789550781"/>
  <xacro:arg name="camera_depth_cx" default="424.1576232910156"/>
  <xacro:arg name="camera_depth_cy" default="238.23983764648438"/>
  <xacro:arg name="camera_depth_hfov" default="1.5844149256643074"/>
  <xacro:arg name="camera_clip_near" default="0.28"/>
  <xacro:arg name="camera_clip_far" default="10.0"/>
  <xacro:arg name="camera_update_rate" default="30.0"/>

  <material name="alu"><color rgba="0.78 0.79 0.81 1.0"/></material>
  <material name="dark"><color rgba="0.22 0.22 0.24 1.0"/></material>
  <material name="accent"><color rgba="0.13 0.42 0.85 1.0"/></material>
  <material name="cad_head_surface"><color rgba="0.792157 0.819608 0.933333 1.0"/></material>

  <!--
    Preserve the full vehicle's world transform without loading its chassis:
      AG_robot base_joint: xyz=0 0 0.2184858, yaw=+pi/2
      base_frame_joint:    identity
    The root is geometry-free and fixed to the Gazebo world.
  -->
  <link name="world"/>
  <link name="base_footprint"/>
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_frame_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
    </inertial>
  </link>
  <joint name="base_frame_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_frame_link"/>
    <origin xyz="0 0 0.2184858" rpy="0 0 1.5707963"/>
  </joint>

  <!-- Left arm (arm1) mount copied verbatim; lift_joint is fixed at its default 0 m. -->
  <xacro:piper_arm prefix="" parent="base_frame_link">
    <origin xyz="0.187732 -0.249047 0.032000" rpy="0 0 -1.5707963"/>
  </xacro:piper_arm>

  <!--
    D435i body pose relative to base_frame_link, obtained by composing the
    original head_joint and camera_joint. At camera_pitch_offset=0 this is
    exactly the full vehicle pose. A non-zero pitch is an explicit optical
    demo override and never changes the camera position or intrinsics.
  -->
  <link name="camera_link">
    <visual>
      <geometry>
        <mesh scale="0.001 0.001 0.001"
              filename="package://piper_lightweight_sim/meshes/realsense_d435i.stl"/>
      </geometry>
      <material name="cad_head_surface"/>
    </visual>
    <collision>
      <origin xyz="-0.012525 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02505 0.090 0.025"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.012949985 -0.000005603 0.000055389" rpy="0 0 0"/>
      <mass value="0.072"/>
      <inertia ixx="0.000052350" ixy="0" ixz="0"
               iyy="0.000007515" iyz="0" izz="0.000052365"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_frame_link"/>
    <child link="camera_link"/>
    <origin xyz="0.006445351 -0.211853207 0.991065428"
            rpy="0 $(arg camera_pitch_offset) -1.570796327"/>
  </joint>

  <link name="camera_depth_frame"/>
  <joint name="camera_depth_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.570796327 0 -1.570796327"/>
  </joint>

  <!-- Only the joints required by the left arm and its gripper are exported. -->
  <ros2_control name="PiperLightweightSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:macro name="position_joint" params="name">
      <joint name="${name}">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>
    <xacro:position_joint name="joint1"/>
    <xacro:position_joint name="joint2"/>
    <xacro:position_joint name="joint3"/>
    <xacro:position_joint name="joint4"/>
    <xacro:position_joint name="joint5"/>
    <xacro:position_joint name="joint6"/>
    <joint name="gripper">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.1</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="gripper_joint1">
      <param name="mimic">gripper</param>
      <param name="multiplier">0.5</param>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="gripper_joint2">
      <param name="mimic">gripper</param>
      <param name="multiplier">-0.5</param>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(find piper_lightweight_sim)/config/ros2_controllers.yaml</parameters>
    </plugin>
    <!--
      Gazebo Harmonic replacement for the Classic link-attacher used by the
      old project.  All joints are detached immediately after spawn; the
      grasp executor attaches only the selected object after the fingers
      reach it and close.
    -->
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <!-- Gazebo's URDF converter merges the fixed gripper_base link into link6. -->
      <parent_link>link6</parent_link>
      <child_model>cube</child_model><child_link>link</child_link>
      <detach_topic>/grasp/cube/detach</detach_topic>
      <attach_topic>/grasp/cube/attach</attach_topic>
      <output_topic>/grasp/cube/state</output_topic>
    </plugin>
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>link6</parent_link>
      <child_model>cuboid</child_model><child_link>link</child_link>
      <detach_topic>/grasp/cuboid/detach</detach_topic>
      <attach_topic>/grasp/cuboid/attach</attach_topic>
      <output_topic>/grasp/cuboid/state</output_topic>
    </plugin>
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>link6</parent_link>
      <child_model>cylinder</child_model><child_link>link</child_link>
      <detach_topic>/grasp/cylinder/detach</detach_topic>
      <attach_topic>/grasp/cylinder/attach</attach_topic>
      <output_topic>/grasp/cylinder/state</output_topic>
    </plugin>
  </gazebo>

  <!-- RGB image and depth image originate from the same RGBD sensor and pixels align. -->
  <gazebo reference="camera_link">
    <sensor name="realsense_d435i_depth" type="rgbd_camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>camera/depth</topic>
      <gz_frame_id>camera_depth_frame</gz_frame_id>
      <update_rate>$(arg camera_update_rate)</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>$(arg camera_depth_hfov)</horizontal_fov>
        <image>
          <width>$(arg camera_depth_width)</width>
          <height>$(arg camera_depth_height)</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>$(arg camera_clip_near)</near>
          <far>$(arg camera_clip_far)</far>
        </clip>
        <depth_camera>
          <clip>
            <near>$(arg camera_clip_near)</near>
            <far>$(arg camera_clip_far)</far>
          </clip>
        </depth_camera>
        <lens>
          <intrinsics>
            <fx>$(arg camera_depth_fx)</fx>
            <fy>$(arg camera_depth_fy)</fy>
            <cx>$(arg camera_depth_cx)</cx>
            <cy>$(arg camera_depth_cy)</cy>
            <s>0.0</s>
          </intrinsics>
        </lens>
        <distortion>
          <k1>0.0</k1><k2>0.0</k2><k3>0.0</k3>
          <p1>0.0</p1><p2>0.0</p2>
          <center>0.5 0.5</center>
        </distortion>
        <optical_frame_id>camera_depth_optical_frame</optical_frame_id>
      </camera>
    </sensor>
  </gazebo>

</robot>
